---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconX from "@/assets/icons/IconX.svg";
import config from "@/config";
const locale = Astro.currentLocale ?? config.site.lang;
const url = (path: string) => getRelativeLocaleUrl(locale, path);
const links = [
  { path: "posts", name: "文章" },
  { path: "categories", name: "分类" },
  { path: "tags", name: "标签" },
  { path: "archives", name: "归档" },
  { path: "about", name: "关于" },
];
---

<a id="skip-to-content" class="skip-link" href="#main-content">跳转到正文</a>
<header class="app-layout site-header">
  <a href={url("")} class="wordmark" aria-label="罗佳佳 Lily · 首页"
    ><span class="monogram" aria-hidden="true">L.</span><span
      >罗佳佳 <span class="wordmark-lily">Lily</span></span
    ></a
  >
  <div class="header-right">
    <nav id="nav-menu" aria-label="主导航">
      <ul id="menu-items" class="nav-links">
        {
          links.map(link => (
            <li>
              <a
                href={url(link.path)}
                aria-current={
                  Astro.url.pathname.startsWith("/" + link.path)
                    ? "page"
                    : undefined
                }
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-tools">
      <a
        class="icon-button"
        href={url("search")}
        aria-label="搜索文章"
        title="搜索文章"><IconSearch /></a
      >
      <button
        id="theme-btn"
        class="icon-button theme-toggle"
        aria-label="切换明暗主题"
        title="切换明暗主题"
        ><IconMoon class="moon" /><IconSunHigh class="sun" /></button
      >
      <button
        id="menu-btn"
        class="icon-button mobile-menu"
        aria-label="展开导航"
        aria-expanded="false"
        aria-controls="menu-items"
        ><IconMenuDeep id="menu-icon" /><IconX
          id="close-icon"
          class="hidden"
        /></button
      >
    </div>
  </div>
</header>
<script>
  function setupMenu() {
    const button = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menu = document.querySelector("#menu-items");
    button?.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") !== "true";
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "收起导航" : "展开导航");
      menu?.classList.toggle("is-open", open);
      document.querySelector("#menu-icon")?.classList.toggle("hidden", open);
      document.querySelector("#close-icon")?.classList.toggle("hidden", !open);
    });
  }
  document.addEventListener("astro:page-load", setupMenu);
</script>
<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 100px;
    position: relative;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-weight: 600;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }
  .monogram {
    display: grid;
    place-items: center;
    width: 30px;
    height: 32px;
    border: 1px solid var(--border);
    border-radius: 7px;
    font-family: Georgia, serif;
    font-size: 21px;
    color: var(--accent);
  }
  .wordmark-lily {
    margin-left: 3px;
    font-weight: 400;
    color: var(--muted-foreground);
  }
  .header-right,
  .nav-links,
  .header-tools {
    display: flex;
    align-items: center;
  }
  .nav-links {
    gap: 23px;
    font-size: 13px;
  }
  .nav-links a {
    color: var(--muted-foreground);
    padding: 10px 0;
  }
  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    color: var(--accent);
  }
  .header-tools {
    margin-left: 25px;
    padding-left: 18px;
    gap: 5px;
    border-left: 1px solid var(--border);
  }
  .icon-button {
    display: grid;
    place-items: center;
    height: 34px;
    width: 34px;
    border-radius: 6px;
    color: var(--muted-foreground);
  }
  .icon-button:hover {
    color: var(--accent);
    background: var(--muted);
  }
  .icon-button :global(svg) {
    width: 18px;
    height: 18px;
  }
  .theme-toggle {
    position: relative;
  }
  .theme-toggle :global(svg) {
    position: absolute;
  }
  .sun {
    display: none;
  }
  :global([data-theme="dark"]) .sun {
    display: block;
  }
  :global([data-theme="dark"]) .moon {
    display: none;
  }
  .mobile-menu {
    display: none;
  }
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -100px;
    z-index: 50;
    background: var(--background);
    padding: 10px;
  }
  .skip-link:focus {
    top: 1rem;
  }
  @media (max-width: 700px) {
    .site-header {
      min-height: 82px;
    }
    .header-tools {
      margin: 0;
      padding: 0;
      border: 0;
    }
    .mobile-menu {
      display: grid;
    }
    .nav-links {
      display: none;
    }
    .nav-links.is-open {
      position: absolute;
      display: flex;
      top: 76px;
      left: 24px;
      right: 24px;
      gap: 0;
      justify-content: space-around;
      padding: 14px 8px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--background);
      z-index: 20;
      box-shadow: 0 8px 20px #00000008;
    }
  }
</style>
