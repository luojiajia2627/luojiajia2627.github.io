---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { getAssetPath } from "@/utils/withBase";
type Props = { noMarginTop?: boolean } & HTMLAttributes<"footer">;
const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const url = (path: string) =>
  getRelativeLocaleUrl(Astro.currentLocale ?? config.site.lang, path);
---

<footer
  class:list={[
    "app-layout site-footer",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div class="footer-inner">
    <div>
      <p>© {new Date().getFullYear()} 罗佳佳 Lily</p><p class="credits">
        Built with <a
          href="https://astro.build/"
          target="_blank"
          rel="noopener noreferrer">Astro</a
        > · Theme based on <a
          href="https://github.com/satnaing/astro-paper"
          target="_blank"
          rel="noopener noreferrer">AstroPaper</a
        >
      </p>
    </div>
    <div class="footer-links">
      <a href={url("categories")}>分类</a><a href={url("tags")}>标签</a>
      <a
        href="https://github.com/luojiajia2627"
        target="_blank"
        rel="noopener noreferrer">GitHub ↗</a
      ><a href={getAssetPath("rss.xml")}>RSS ↗</a><a href={url("about")}
        >关于这个博客</a
      >
    </div>
  </div>
</footer>
<style>
  .site-footer {
    padding-top: 58px;
    padding-bottom: 30px;
    color: var(--muted-foreground);
    font-size: 16px;
  }
  .footer-inner {
    border-top: 1px solid var(--border);
    padding-top: 25px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
  }
  .credits {
    font-size: 14px;
    margin-top: 5px;
    opacity: 0.8;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    row-gap: 8px;
    gap: 16px;
  }
  a:hover {
    color: var(--accent);
  }
  @media (max-width: 500px) {
    .footer-inner {
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
