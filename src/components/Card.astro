---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
type Props = { variant?: "h2" | "h3" } & CollectionEntry<"posts">;
const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const date = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: "Asia/Shanghai",
})
  .format(data.pubDatetime)
  .replaceAll("/", ".");
---

<li class="post-row">
  <a class="post-title" href={getPostUrl(id, filePath, locale)}
    ><Heading>{data.title}</Heading></a
  >
  <p class="post-description">{data.description}</p>
  <div class="post-meta">
    <time datetime={data.pubDatetime.toISOString()}>{date}</time><a
      href={getRelativeLocaleUrl(
        locale,
        "categories/" + slugifyStr(data.category)
      )}>{data.category}</a
    >{
      data.demo && (
        <span class="demo-label">
          {data.kind === "thought" ? "示例思考" : "示例文章"}
        </span>
      )
    }
  </div>
</li>
<style>
  .post-row {
    border-bottom: 1px solid var(--border);
    padding: 26px 0 24px;
  }
  .post-title {
    display: inline;
    line-height: 1.75;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
  }
  .post-title :global(h2),
  .post-title :global(h3) {
    display: inline;
    font-size: 18px;
    font-weight: 550;
    letter-spacing: -0.02em;
  }
  .post-title:hover {
    text-decoration-color: var(--muted-foreground);
  }
  .post-description {
    color: var(--muted-foreground);
    font-size: 13px;
    line-height: 1.95;
    margin-top: 10px;
  }
  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    font-size: 10px;
    color: var(--muted-foreground);
    margin-top: 14px;
  }
  time {
    font-variant-numeric: tabular-nums;
  }
  .post-meta a:hover {
    color: var(--foreground);
  }
  .demo-label {
    font-size: 9px;
  }
  @media (max-width: 550px) {
    .post-row {
      padding: 23px 0;
    }
    .post-title :global(h2),
    .post-title :global(h3) {
      font-size: 17px;
    }
    .post-description {
      font-size: 12px;
    }
  }
</style>
