---
const { title = "交流与补充" } = Astro.props;
---

<section
  class="comments-section"
  data-comments
  aria-labelledby="comments-heading"
>
  <div class="comments-heading">
    <div>
      <h2 id="comments-heading">
        {title}
      </h2>
    </div><a
      data-comment-link
      class="lab-button"
      href="https://github.com/luojiajia2627/luojiajia2627.github.io/issues"
      target="_blank"
      rel="noopener noreferrer">在 GitHub 评论 ↗</a
    >
  </div>
  <p class="comments-intro">
    一个问题、一份补充，或一个不同的视角。使用 GitHub
    账号留言，通常约一分钟后自动同步到这里。
  </p>
  <p data-comment-status class="comment-status" role="status">
    评论区准备中。也可以前往 GitHub 查看。
  </p>
  <ul data-comment-list class="comment-list" aria-label="读者评论"></ul>
  <button data-comments-more class="quiet-link comment-more" hidden
    >加载更多评论 ↓</button
  >
  <button data-comments-retry class="quiet-link comment-more" hidden
    >重新加载 ↻</button
  >
  <noscript
    ><p>
      开启 JavaScript 可在这里阅读评论，或点击上方链接前往 GitHub。
    </p></noscript
  >
</section>
<script>
  let threadMap:
    Promise<Record<string, { number: number; url: string }>> | undefined;
  function setupComments() {
    const section = document.querySelector<HTMLElement>("[data-comments]");
    if (!section || section.dataset.ready) return;
    section.dataset.ready = "true";
    const status = section.querySelector<HTMLElement>("[data-comment-status]")!;
    const list = section.querySelector<HTMLUListElement>(
      "[data-comment-list]"
    )!;
    const link = section.querySelector<HTMLAnchorElement>(
      "[data-comment-link]"
    )!;
    const more = section.querySelector<HTMLButtonElement>(
      "[data-comments-more]"
    )!;
    const retry = section.querySelector<HTMLButtonElement>(
      "[data-comments-retry]"
    )!;
    const path =
      "/" + location.pathname.split("/").filter(Boolean).join("/") + "/";
    let page = 1;
    let number = 0;
    let loading = false;
    async function load() {
      if (loading) return;
      loading = true;
      retry.hidden = true;
      more.disabled = true;
      status.textContent = "正在读取评论…";
      try {
        if (!number) {
          threadMap ??= fetch("/comment-threads.json")
            .then(async response => {
              if (!response.ok) throw new Error("Thread map unavailable");
              return response.json();
            })
            .catch(error => {
              threadMap = undefined;
              throw error;
            });
          const thread = (await threadMap)[path];
          if (!thread) throw new Error("Thread not provisioned");
          number = thread.number;
          link.href = thread.url + "#new_comment_field";
        }
        const response = await fetch(`/comment-snapshots/${number}.json`);
        if (!response.ok) throw new Error("Comments unavailable");
        const allComments = await response.json();
        if (!Array.isArray(allComments)) throw new Error("Invalid response");
        const comments = allComments.slice((page - 1) * 20, page * 20);
        for (const comment of comments) {
          const item = document.createElement("li");
          const heading = document.createElement("div");
          heading.className = "comment-byline";
          const author = document.createElement("a");
          author.textContent = comment.user?.login ?? "GitHub 用户";
          author.href =
            "https://github.com/" +
            encodeURIComponent(comment.user?.login ?? "");
          author.target = "_blank";
          author.rel = "noopener noreferrer";
          const date = document.createElement("time");
          date.dateTime = comment.created_at;
          date.textContent = new Date(comment.created_at).toLocaleDateString(
            "zh-CN"
          );
          heading.append(author, date);
          const body = document.createElement("p");
          // Text nodes keep readers' HTML/Markdown safe; full formatting is available on GitHub.
          body.textContent = comment.body ?? "";
          item.append(heading, body);
          list.append(item);
        }
        more.hidden = allComments.length <= page * 20;
        page++;
        status.textContent = list.children.length
          ? ""
          : "还没有评论，欢迎留下第一个想法。";
      } catch {
        status.textContent =
          "暂时无法读取评论。你仍可以点击上方按钮，在 GitHub 阅读和留言。";
        retry.hidden = false;
      } finally {
        loading = false;
        more.disabled = false;
      }
    }
    more.addEventListener("click", load);
    retry.addEventListener("click", load);
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        entries => {
          if (entries.some(entry => entry.isIntersecting)) {
            observer.disconnect();
            void load();
          }
        },
        { rootMargin: "250px" }
      );
      observer.observe(section);
      document.addEventListener(
        "astro:before-swap",
        () => observer.disconnect(),
        { once: true }
      );
    } else void load();
    // Resolve the comment link immediately even before lazy-loading the comments.
    threadMap ??= fetch("/comment-threads.json")
      .then(response => {
        if (!response.ok) throw new Error("No thread map");
        return response.json();
      })
      .catch(() => {
        threadMap = undefined;
        return {};
      });
    void threadMap.then(map => {
      if (map[path]) {
        number = map[path].number;
        link.href = map[path].url + "#new_comment_field";
      }
    });
  }
  document.addEventListener("astro:page-load", setupComments);
</script>
<style>
  .comments-section {
    margin-top: 50px;
    padding-top: 30px;
    border-top: 1px solid var(--border);
  }
  .comments-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  h2 {
    font-size: 24px;
    font-weight: 600;
    margin-top: 5px;
  }
  h2 span {
    color: var(--accent);
  }
  .comments-intro,
  .comment-status {
    color: var(--muted-foreground);
    font-size: 16px;
    margin: 15px 0;
  }
  .comment-status:not(:empty) {
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 18px;
  }
  .comment-list :global(li) {
    border-top: 1px solid var(--border);
    padding: 22px 0;
  }
  .comment-list :global(.comment-byline) {
    display: flex;
    gap: 18px;
    align-items: center;
    font-size: 16px;
  }
  .comment-list :global(a) {
    color: var(--accent);
    font-weight: 600;
  }
  .comment-list :global(time) {
    color: var(--muted-foreground);
    font-size: 14px;
  }
  .comment-list :global(p) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    margin-top: 10px;
    font-size: 18px;
  }
  .comment-more {
    font-size: 16px;
    margin-top: 16px;
  }
  @media (max-width: 520px) {
    .comments-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
  }
</style>
