---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getDocuments } from "@/utils/getDocuments";
const documents = await getDocuments();
---

<Layout
  title="资料 | 罗佳佳 Lily"
  description="论文批注、学习笔记与 PDF 文档。在线阅读或下载。"
>
  <Header /><main id="main-content" class="app-layout collection-page">
    <div class="page-heading">
      <div><h1>资料</h1><p>一些论文批注、学习笔记，和值得回看的文档。</p></div>
    </div>
    <div class="collection-toolbar">
      <span>{documents.length} 份 PDF</span><a
        href="https://github.com/luojiajia2627/luojiajia2627.github.io/upload/main/public/documents"
        target="_blank"
        rel="noopener noreferrer"
        class="quiet-link"
        title="作者通过 GitHub 上传资料">上传 PDF ↗</a
      >
    </div>
    <ul class="documents">
      {
        documents.map(doc => (
          <li>
            <>
              <div class="document-copy">
                <>
                  <a href={doc.url}>
                    <h2>{doc.title}</h2>
                  </a>
                  <p>{doc.description}</p>
                  <div class="document-meta">
                    <span>PDF · {doc.sizeLabel}</span>
                    {doc.date && <time>{doc.date}</time>}
                    {doc.demo && <span>功能示例</span>}
                  </div>
                </>
              </div>
              <a
                class="download-link quiet-link"
                href={doc.file}
                download={doc.filename}
                aria-label={"下载 " + doc.title}
              >
                下载 ↓
              </a>
            </>
          </li>
        ))
      }
    </ul>
    {
      documents.length === 0 && (
        <div class="empty-state">
          <>
            <h2>还没有资料</h2>
            <p>上传 PDF 后，会自动收录在这里。</p>
          </>
        </div>
      )
    }
  </main><Footer />
</Layout>
<style>
  .documents li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 25px;
    align-items: baseline;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
  }
  h2 {
    font-size: 20px;
    font-weight: 550;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .document-copy > a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .document-copy > p {
    font-size: 15px;
    line-height: 1.95;
    color: var(--muted-foreground);
    margin-top: 9px;
  }
  .document-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    color: var(--muted-foreground);
    font-size: 11px;
    margin-top: 15px;
  }
  .download-link {
    font-size: 12px;
    white-space: nowrap;
  }
  @media (max-width: 500px) {
    .documents li {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    h2 {
      font-size: 18px;
    }
    .download-link {
      justify-self: start;
    }
  }
</style>
