---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Comments from "@/components/Comments.astro";
import PdfReader from "@/components/PdfReader.astro";
import { getDocuments, type BlogDocument } from "@/utils/getDocuments";
export async function getStaticPaths() {
  return (await getDocuments()).map(doc => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}
const { doc } = Astro.props as { doc: BlogDocument };
---

<Layout
  title={doc.title + " | PDF 资料库 · 罗佳佳 Lily"}
  description={doc.description}
>
  <Header /><main id="main-content" class="app-layout collection-page pdf-page">
    <a href="/library/" class="quiet-link back-link">← 返回 PDF 资料库</a>
    <header class="pdf-heading">
      <p class="eyebrow">{doc.demo ? "功能示例" : "PDF 文档"}</p><h1>
        {doc.title}
      </h1><p>{doc.description}</p><div class="pdf-meta">
        <span>PDF · {doc.sizeLabel}</span>{doc.date && <time>{doc.date}</time>}{
          doc.tags.map(tag => <span>#{tag}</span>)
        }
      </div>
    </header>
    <div class="pdf-toolbar">
      <span>文档阅读器</span><div>
        <a href={doc.file} target="_blank" rel="noopener noreferrer"
          >在新窗口打开 ↗</a
        ><a class="lab-button" href={doc.file} download={doc.filename}
          >下载 PDF ↓</a
        >
      </div>
    </div>
    <PdfReader file={doc.file} title={doc.title} />
    <p class="pdf-reader-note">
      支持翻页、缩放和文字提取；也可以在新窗口打开原始 PDF。
    </p>
    <Comments title="读完之后，聊聊看" />
  </main><Footer />
</Layout>
<style>
  .back-link {
    font-size: 14px;
  }
  .pdf-heading {
    margin: 30px 0;
  }
  h1 {
    font-size: clamp(25px, 4vw, 36px);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 10px 0;
    overflow-wrap: anywhere;
  }
  .pdf-heading > p:not(.eyebrow) {
    color: var(--muted-foreground);
    font-size: 16px;
  }
  .pdf-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 20px;
    font-size: 12px;
    color: var(--muted-foreground);
  }
  .pdf-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid var(--border);
    padding: 13px 16px;
    font-size: 12px;
    background: var(--surface);
    gap: 16px;
  }
  .pdf-toolbar > div {
    display: flex;
    gap: 18px;
    align-items: center;
  }
  .pdf-reader-note {
    font-size: 11px;
    color: var(--muted-foreground);
    margin-top: 10px;
  }
  @media (max-width: 520px) {
    .pdf-toolbar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
