---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { getCategories } from "@/utils/getCategories";
import config from "@/config";
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const categories = getCategories(await getCollection("posts"));
  return categories.flatMap(category =>
    paginate(category.posts, {
      params: { category: category.slug },
      props: { name: category.name, description: category.description },
      pageSize: config.posts.perPage,
    })
  );
}
const { page, name, description } = Astro.props;
---

<Layout title={name + " | " + config.site.title}>
  <Header /><Breadcrumb />
  <Main pageTitle={name} pageDesc={description}>
    <ul>{page.data.map(post => <Card {...post} />)}</ul>
    {
      page.total === 0 && (
        <p class="text-muted-foreground py-12">
          这个方向的第一篇笔记正在路上。
        </p>
      )
    }
  </Main><Pagination {page} /><Footer />
</Layout>
