---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { getDocuments } from "@/utils/getDocuments";
const all = getSortedPosts(await getCollection("posts"));
const posts = all.filter(post => post.data.kind === "article");
const thoughts = all.filter(post => post.data.kind === "thought");
const documents = await getDocuments();
const topics = ["扩散语言模型", "推荐算法", "前后端开发"];
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout home" data-home-path="/">
    <section class="intro" aria-labelledby="intro-heading">
      <h1 id="intro-heading">罗佳佳 <em>Lily</em></h1>
      <p>
        记录技术学习与实践，也写一些个人思考。<br
        />在模型、算法和代码之间，慢慢积累自己的理解。
      </p>
      <div class="interests" aria-label="关注的技术方向">
        {
          topics.map(topic => (
            <a href={"/categories/" + slugifyStr(topic) + "/"}>{topic}</a>
          ))
        }
      </div>
      <div class="intro-links">
        <a href="/about/">关于我</a><a
          href="https://github.com/luojiajia2627"
          target="_blank"
          rel="noopener noreferrer">GitHub ↗</a
        ><a href="/rss.xml">RSS</a>
      </div>
    </section>
    <section class="recent" aria-labelledby="recent-heading">
      <div class="section-heading">
        <h2 id="recent-heading">最近文章</h2><a href="/posts/">全部文章</a>
      </div>
      <ul>{posts.slice(0, 4).map(post => <Card variant="h3" {...post} />)}</ul>
      {posts.length === 0 && <p class="empty-note">第一篇笔记正在路上。</p>}
    </section>
    <div class="reading-desk">
      <section aria-labelledby="thoughts-heading">
        <div class="section-heading">
          <h2 id="thoughts-heading">个人思考</h2><a href="/thoughts/">全部</a>
        </div>{
          thoughts[0] ? (
            <div class="small-entry">
              <>
                <a href={getPostUrl(thoughts[0].id, thoughts[0].filePath)}>
                  <h3>{thoughts[0].data.title}</h3>
                </a>
                <p>{thoughts[0].data.description}</p>
                {thoughts[0].data.demo && (
                  <span class="entry-meta">栏目示例</span>
                )}
              </>
            </div>
          ) : (
            <p class="empty-note">给还没想明白的问题，留一点空间。</p>
          )
        }
      </section>
      <section aria-labelledby="library-heading">
        <div class="section-heading">
          <h2 id="library-heading">资料</h2><a href="/library/">全部</a>
        </div>{
          documents.slice(0, 2).map(doc => (
            <div class="small-entry">
              <>
                <a href={doc.url}>
                  <h3>{doc.title}</h3>
                </a>
                <p>{doc.description}</p>
                <span class="entry-meta">
                  PDF · {doc.sizeLabel}
                  {doc.demo && " · 功能示例"}
                </span>
              </>
            </div>
          ))
        }{
          documents.length === 0 && (
            <p class="empty-note">保存一些值得回看的阅读资料。</p>
          )
        }
      </section>
    </div>
  </main><Footer />
</Layout>
<script>
  document.addEventListener("astro:page-load", () => {
    if (document.querySelector("[data-home-path]"))
      sessionStorage.setItem("backUrl", "/");
  });
</script>
<style>
  .intro {
    padding: 73px 0 61px;
  }
  h1 {
    font-family: var(--font-editorial);
    font-size: 38px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  h1 em {
    font-weight: 400;
    margin-left: 8px;
  }
  .intro > p {
    color: var(--muted-foreground);
    font-size: 15px;
    line-height: 2;
    margin-top: 22px;
  }
  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 20px;
    margin-top: 22px;
    font-size: 12px;
    color: var(--muted-foreground);
  }
  .interests a:hover {
    color: var(--foreground);
  }
  .intro-links {
    display: flex;
    gap: 21px;
    margin-top: 26px;
    font-size: 12px;
  }
  .intro-links a {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: var(--border);
  }
  .intro-links a:hover {
    text-decoration-color: var(--foreground);
  }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .section-heading h2 {
    font-size: 16px;
    font-weight: 550;
  }
  .section-heading > a {
    font-size: 11px;
    color: var(--muted-foreground);
  }
  .section-heading > a:hover {
    color: var(--foreground);
  }
  .reading-desk {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 46px;
    margin-top: 52px;
  }
  .small-entry {
    margin-top: 23px;
  }
  .small-entry h3 {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.8;
  }
  .small-entry > p {
    font-size: 12px;
    color: var(--muted-foreground);
    line-height: 1.9;
    margin-top: 10px;
  }
  .entry-meta {
    display: block;
    font-size: 10px;
    color: var(--muted-foreground);
    margin-top: 12px;
  }
  .empty-note {
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted-foreground);
    padding-top: 23px;
  }
  @media (max-width: 600px) {
    .intro {
      padding: 46px 0 44px;
    }
    h1 {
      font-size: 33px;
    }
    .intro > p {
      font-size: 14px;
    }
    .reading-desk {
      grid-template-columns: 1fr;
      gap: 36px;
      margin-top: 38px;
    }
  }
</style>
