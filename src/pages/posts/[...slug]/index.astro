---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import { getPostSlug } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import AdjacentPostNav from "./_components/AdjacentPostNav.astro";
import config from "@/config";

export async function getStaticPaths() {
  const posts = getSortedPosts(await getCollection("posts"));
  const adjacent = (post: CollectionEntry<"posts"> | undefined) =>
    post
      ? { id: post.id, title: post.data.title, filePath: post.filePath }
      : null;
  return posts.map((post, index) => ({
    params: { slug: getPostSlug(post.id, post.filePath) },
    props: {
      post,
      prevPost: adjacent(posts[index + 1]),
      nextPost: adjacent(posts[index - 1]),
    },
  }));
}
type Adjacent = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;
type Props = {
  post: CollectionEntry<"posts">;
  prevPost: Adjacent;
  nextPost: Adjacent;
};
const { post, prevPost, nextPost } = Astro.props;
const { title, description, pubDatetime, modDatetime, tags, category, demo } =
  post.data;
const { Content, headings } = await render(post);
const toc = headings.filter(
  heading => heading.depth === 2 || heading.depth === 3
);
const minutes = Math.max(1, Math.ceil((post.body?.length ?? 0) / 450));
const categoryUrl = getRelativeLocaleUrl(
  config.site.lang,
  "categories/" + slugifyStr(category)
);
---

<PostLayout
  title={title + " | " + config.site.title}
  {description}
  {pubDatetime}
  {modDatetime}
  canonicalURL={post.data.canonicalURL}
>
  <Header />
  <main id="main-content" class="app-layout article-page">
    <a
      class="article-back quiet-link"
      href={getRelativeLocaleUrl(config.site.lang, "posts")}>← 所有文章</a
    >
    <header class="article-heading">
      <a class="article-category" href={categoryUrl}>{category}</a>
      <h1>{title}</h1>
      <p class="article-lead">{description}</p>
      <div class="article-meta">
        <Datetime {pubDatetime} {modDatetime} /><span>·</span><span
          >{minutes} 分钟阅读</span
        ><span>·</span><span>罗佳佳 Lily</span>
      </div>
    </header>
    {
      demo && (
        <aside class="demo-notice">
          <span>示例文章</span>{" "}
          本文用于展示博客的阅读排版与功能，发布自己的内容时可删除或替换。
        </aside>
      )
    }
    {
      toc.length > 0 && (
        <details class="article-toc" open>
          <>
            <summary>文章目录</summary>
            <ol>
              {toc.map(heading => (
                <li class:list={{ nested: heading.depth === 3 }}>
                  <a href={"#" + heading.slug}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </>
        </details>
      )
    }
    <article
      id="article"
      class="app-prose prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg) max-w-none"
    >
      <Content />
    </article>
    <div class="article-bottom">
      <ul class="flex flex-wrap gap-4">
        {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
      </ul><a href="#main-content" class="quiet-link">回到顶部 ↑</a>
    </div>
    <div><AdjacentPostNav {prevPost} {nextPost} /></div>
  </main>
  <Footer />
</PostLayout>
<script>
  function setupArticle() {
    document.querySelectorAll<HTMLPreElement>("#article pre").forEach(block => {
      if (block.querySelector(".copy-code")) return;
      block.style.position = "relative";
      block.tabIndex = 0;
      const button = document.createElement("button");
      button.className = "copy-code";
      button.type = "button";
      button.textContent = "复制";
      button.setAttribute("aria-label", "复制代码");
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(
            block.querySelector("code")?.textContent ?? ""
          );
          button.textContent = "已复制";
        } catch {
          button.textContent = "请手动复制";
        }
        setTimeout(() => {
          button.textContent = "复制";
        }, 1500);
      });
      block.appendChild(button);
    });
  }
  document.addEventListener("astro:page-load", setupArticle);
</script>
<style>
  .article-page {
    padding-top: 36px;
  }
  .article-back {
    font-size: 12px;
  }
  .article-heading {
    margin: 35px 0 30px;
  }
  .article-category {
    font-size: 12px;
    color: var(--accent);
  }
  h1 {
    font-weight: 600;
    font-size: clamp(26px, 4vw, 35px);
    letter-spacing: -0.035em;
    line-height: 1.6;
    margin: 10px 0 16px;
  }
  .article-lead {
    color: var(--muted-foreground);
    line-height: 1.9;
    font-size: 15px;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
    font-size: 11px;
    color: var(--muted-foreground);
  }
  .demo-notice {
    padding: 13px 16px;
    font-size: 12px;
    background: var(--muted);
    color: var(--muted-foreground);
    border-radius: 5px;
    line-height: 1.9;
  }
  .demo-notice span {
    color: var(--accent);
    font-weight: 500;
    margin-right: 8px;
  }
  .article-toc {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 17px 0;
    margin: 28px 0 35px;
    font-size: 13px;
  }
  .article-toc summary {
    cursor: pointer;
    font-weight: 500;
  }
  .article-toc ol {
    padding-left: 19px;
    margin-top: 12px;
    color: var(--muted-foreground);
  }
  .article-toc li {
    margin: 4px 0;
  }
  .article-toc .nested {
    margin-left: 16px;
    font-size: 12px;
  }
  .article-toc a:hover {
    color: var(--accent);
  }
  .article-bottom {
    margin-top: 45px;
    padding: 22px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 20px;
    justify-content: space-between;
  }
  .article-bottom > a {
    white-space: nowrap;
    font-size: 12px;
  }
  :global(.copy-code) {
    position: absolute;
    right: 10px;
    top: 8px;
    font: 11px var(--font-app);
    padding: 3px 8px;
    border-radius: 4px;
    color: var(--muted-foreground);
    background: var(--muted);
  }
</style>
