---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
const thoughts = getSortedPosts(await getCollection("posts")).filter(
  post => post.data.kind === "thought"
);
---

<Layout
  title="个人思考 | 罗佳佳 Lily"
  description="记录问题、观察，以及尚未成形的个人思考。"
>
  <Header /><main id="main-content" class="app-layout collection-page">
    <div class="page-heading">
      <div><h1>个人思考</h1><p>记录一些问题和观察，允许想法尚未完成。</p></div>
    </div>
    <div class="collection-toolbar">
      <span>{thoughts.length} 条思考</span><a href="/posts/" class="quiet-link"
        >技术文章 →</a>
    </div>
    <ul>{thoughts.map(post => <Card {...post} />)}</ul>
    {
      thoughts.length === 0 && (
        <div class="empty-state">
          <>
            <h2>第一条思考，留给未来的自己。</h2>
            <p>可以从一个暂时没有答案的问题开始。</p>
          </>
        </div>
      )
    }
  </main><Footer />
</Layout>
